{
  "name": "fandomloop-india",
  "version": "1.0.0",
  "description": "Demand-testing platform for licensed anime merch",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:prod": "node scripts/use-provider.mjs && prisma generate && tsc",
    "start": "node dist/index.js",
    "start:prod": "prisma db push && node dist/index.js",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "seed:prod": "tsx src/seed.ts",
    "eval:import": "tsx src/eval/import_csv.ts",
    "eval:run": "tsx src/eval/run.ts",
    "analyze": "tsx src/eval/analyze.ts",
    "demo:reset": "prisma db push --force-reset && tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.16.1",
    "cors": "2.8.5",
    "dotenv": "^16.4.5",
    "express": "4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "prisma": "5.16.1",
    "supertest": "7.0.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "2.0.3"
  }
}
