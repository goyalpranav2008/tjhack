# ── Database ──────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL="file:./prisma/dev.db"
DB_PROVIDER="sqlite"

# Postgres (production — Render, Supabase, Railway, etc.):
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
# DB_PROVIDER="postgresql"

# ── App secrets ───────────────────────────────────────────────────────────
SERVER_SECRET="change-me-to-a-long-random-string"
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ── Studio API key ─────────────────────────────────────────────────────────
# Protects POST /api/campaigns and POST /api/campaigns/:slug/settle.
# Leave empty to bypass in local dev. Set a long random string in production.
STUDIO_API_KEY=

# ── LLM (optional) ────────────────────────────────────────────────────────
# If not set, the brief endpoint returns a clearly labelled template brief.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
