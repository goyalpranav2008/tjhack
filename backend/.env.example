# ── Database ──────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL="file:./prisma/dev.db"

# Postgres (production — Render, Supabase, Railway, etc.):
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# Controls which Prisma provider use-provider.mjs writes into schema.prisma.
# Leave as "sqlite" for local dev. Set to "postgresql" in production.
DB_PROVIDER="sqlite"

# ── App secrets ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# NEVER leave as "fallback-secret" in production — the server will refuse to start.
SERVER_SECRET="change-me-to-a-long-random-string"
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Set to your Vercel URL in production, e.g. https://fandomloop.vercel.app
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ── Studio API key ─────────────────────────────────────────────────────────
# Protects POST /api/campaigns and POST /api/campaigns/:slug/settle.
# Generate with: openssl rand -hex 24
# Leave EMPTY in local dev to bypass auth.
STUDIO_API_KEY=

# ── LLM (optional) ────────────────────────────────────────────────────────
# If not set, the brief endpoint returns a clearly labelled template brief.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Rate limiting ─────────────────────────────────────────────────────────
# Fan-facing write routes (consent + pledge): requests per 15 min per IP.
# 300 is generous for shared event Wi-Fi. Lower to 30 for tighter control.
FAN_RATE_MAX=300

# ── Test fee (shown in Console "FandomLoop earns" card) ──────────────────
TEST_FEE_INR=10000

# ── Demo mode ─────────────────────────────────────────────────────────────
# When true, POST /api/demo/reset is available (studio key required).
# Set to false or omit in production to disable the reset endpoint.
DEMO_MODE=true
